{
  "manifest_version": 3,
  "name": "Better Jira",
  "short_name": "Better Jira",
  "version": "1.0.5",
  "description": "Open users profile and tickets from Jira directly in Betler and Bookie. Author: Daniel Oliveira",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://axilis.atlassian.net/*", "https://*.slack.com/*"],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "servicedesk-to-jira",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "content_scripts": [
    {
      "matches": ["https://axilis.atlassian.net/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://*.slack.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}